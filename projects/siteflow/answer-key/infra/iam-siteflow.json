{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOneBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::siteflow-docs-YOURNAME"
    },
    {
      "Sid": "ReadWriteObjectsInOneBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::siteflow-docs-YOURNAME/*"
    }
  ]
}
