{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProjectPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::siteflow-docs-YOURNAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["projects/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteProjectObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::siteflow-docs-YOURNAME/projects/*"
    }
  ]
}
