{
  "dataset": "products",
  "owner": "catalog-team",
  "description": "Product master / catalog.",
  "primary_key": ["product_id"],
  "freshness_sla_hours": 168,
  "columns": [
    {"name": "product_id", "type": "VARCHAR", "required": true, "unique": true},
    {"name": "product_name", "type": "VARCHAR", "required": true},
    {"name": "category_name", "type": "VARCHAR", "required": true},
    {"name": "temp_zone", "type": "VARCHAR", "required": true,
     "accepted_values": ["ambient", "chilled", "frozen"]},
    {"name": "supplier_id", "type": "VARCHAR", "required": true},
    {"name": "unit_cost", "type": "DOUBLE", "required": true, "min": 0},
    {"name": "list_price", "type": "DOUBLE", "required": true, "min": 0}
  ]
}
